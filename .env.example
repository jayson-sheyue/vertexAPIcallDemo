# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，勿提交）
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# 可选：SA 模拟（子进程回退时生效）
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=dev-sa@your-project-id.iam.gserviceaccount.com

# 短期 access token（约 1 小时有效）
# 获取: gcloud auth print-access-token [--impersonate-service-account=...]
GOOGLE_ACCESS_TOKEN=

GOOGLE_GENAI_API_VERSION=v1
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PROMPT=How does AI work?
